# ==========================================
# KONFIGURASI WEBSITE RESMI DESA
# ==========================================

# Nama aplikasi, akan muncul di beberapa tempat (gunakan tanda kutip jika ada spasi)
APP_NAME="Website Resmi Desa"
# Mode lingkungan: 'local' untuk pengembangan, 'production' untuk server cPanel (live)
APP_ENV=local
# Kunci keamanan aplikasi (akan diisi otomatis saat instalasi)
APP_KEY=
# Tampilkan detail error. Wajib 'false' di server production (cPanel) agar aman
APP_DEBUG=true
# Zona waktu aplikasi
APP_TIMEZONE=Asia/Jakarta
# URL utama website, contoh di cPanel: https://desadamai.desa.id
APP_URL=http://localhost

# Bahasa aplikasi
APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

# Driver untuk halaman maintenance
APP_MAINTENANCE_DRIVER=file

# Pekerja server CLI
PHP_CLI_SERVER_WORKERS=4

# Putaran enkripsi bcrypt
BCRYPT_ROUNDS=12

# Pengaturan log error
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ==========================================
# PENGATURAN DATABASE (Ubah saat di cPanel)
# ==========================================
# Ganti sqlite menjadi mysql untuk cPanel
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=nama_database_cpanel
# DB_USERNAME=user_database_cpanel
# DB_PASSWORD=password_database_cpanel

# ==========================================
# PENGATURAN SESI & CACHE
# ==========================================
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=file
CACHE_PREFIX=

# ==========================================
# PENGATURAN EMAIL (Kosongkan jika tidak dipakai)
# ==========================================
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@desa.id"
MAIL_FROM_NAME="${APP_NAME}"

# ==========================================
# IDENTITAS & KREDENSIAL AWAL DESA
# ==========================================
# Akun superadmin default (digunakan saat php artisan db:seed)
SUPERADMIN_NAME="Super Admin Desa"
SUPERADMIN_EMAIL="superadmin@desadamai.id"
SUPERADMIN_PASSWORD="password123"

# Identitas Desa (ditampilkan di header/footer website)
VILLAGE_NAME="Desa Damai"
VILLAGE_DISTRICT="Kecamatan X"
VILLAGE_REGENCY="Kabupaten Y"
